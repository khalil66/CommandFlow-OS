# Copy this file to .env and fill in real values locally. Never commit .env.
# (See supabase/rollback_scripts and the Phase 0 report for why this file
# was added — a real .env was previously committed to git history.)

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Referenced elsewhere in the codebase (src/lib/*.functions.ts,
# src/integrations/supabase/client.server.ts) but NOT present in the
# previously-committed .env — these are supplied via the runtime/deployment
# environment (e.g. Lovable/Cloudflare secret config), not a local .env file:
